{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=supplychainx_db;Username=postgres;Password=postgres_dev_password"
  },
  "AiCopilot": {
    "Provider": "Auto",
    "OpenAiApiKey": "",
    "OpenAiModel": "gpt-4o-mini",
    "AzureOpenAiEndpoint": "",
    "AzureOpenAiApiKey": "",
    "AzureOpenAiDeploymentName": "gpt-4o-mini",
    "Temperature": 0.2
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "supplychainx-event-consumers",
    "Topics": {
      "ProductEvents": "supplychainx.product.events",
      "WarehouseEvents": "supplychainx.warehouse.events",
      "InventoryEvents": "supplychainx.inventory.events",
      "ProductEventsDlq": "supplychainx.product.events.dlq",
      "WarehouseEventsDlq": "supplychainx.warehouse.events.dlq",
      "InventoryEventsDlq": "supplychainx.inventory.events.dlq"
    },
    "Consumer": {
      "ConsumerGroupId": "supplychainx-event-consumers",
      "EnableAutoCommit": false,
      "AutoOffsetReset": "Earliest",
      "MaxRetryAttempts": 3,
      "RetryDelayMs": 1000,
      "UseExponentialBackoff": true
    },
    "Retry": {
      "MaxRetryAttempts": 3,
      "InitialDelayMs": 1000,
      "UseExponentialBackoff": true
    },
    "DeadLetter": {
      "ProductDlqTopic": "supplychainx.product.events.dlq",
      "WarehouseDlqTopic": "supplychainx.warehouse.events.dlq",
      "InventoryDlqTopic": "supplychainx.inventory.events.dlq"
    }
  }
}
